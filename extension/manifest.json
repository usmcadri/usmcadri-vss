{
  "manifest_version": 3,
  "name": "VSS Accessibility Tools",
  "version": "0.2.0",
  "description": "Lightweight accessibility viewer presets and reading ruler for Visual Snow Syndrome (VSS).",
  "action": {
    "default_title": "VSS Tools",
    "default_popup": "popup.html"
  },
  "permissions": ["storage", "tabs"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
